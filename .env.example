# Optional. Only needed for `expensify-scraper export`.
# Generate at https://www.expensify.com/tools/integrations/
# EXPENSIFY_PARTNER_USER_ID=
# EXPENSIFY_PARTNER_USER_SECRET=

# Paths (optional overrides)
# EXPENSIFY_OUTPUT_DIR=out
# EXPENSIFY_DATA_DIR=data
# EXPENSIFY_AUTH_DIR=.auth

# Export start date and download parallelism
# EXPENSIFY_SINCE=2015-01-01
# EXPENSIFY_DOWNLOAD_CONCURRENCY=4
